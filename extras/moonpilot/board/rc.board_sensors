#!/bin/sh
#
# board specific sensors init - MoonPilot (STM32H743VI)
#------------------------------------------------------------------------------

board_adc start

# Internal SPI bus 1: ICM-42688-P #1 (U2), CS PC15, DRDY PB2
icm42688p -R 12 -b 1 -s start

# Internal SPI bus 4: ICM-42688-P #2 (U3), CS PE11, DRDY PE15
icm42688p -R 12 -b 4 -s start

# Internal barometer on I2C2 (0x76)
dps310 -I start -a 118

# Internal magnetometer on I2C2 (0x0E = 14)
ist8310 -I start -a 14

# Nooploop TOFSense rangefinder
#
# The refurbished driver is board independent and is normally started from the
# standard PX4 serial configuration parameter SENS_TOFMS_CFG (QGC: Sensors).
# This legacy MoonPilot board target only declares GPS1 in
# CONFIG_BOARD_SERIAL_*, so ttyS1 (UART2 RX, U11.6) has no standard tag here.
#
# Options on this board:
#   1. temporary / debug:
#        tof_sense_ms start -d /dev/ttyS1 -b 921600 -R 25
#   2. permanent: declare the port in default.px4board, e.g.
#        CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS1"
#      then select SENS_TOFMS_CFG = 101 in QGC and set MAV_0_CONFIG to another
#      port (TELEM 1 would otherwise be claimed by MAVLink).

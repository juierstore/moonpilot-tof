@@ -0,0 +1,55 @@
+#!/bin/sh
+#
+# @name MoonPilot Juier
+#
+# @type Quadrotor x
+# @class Copter
+#
+# @maintainer juier
+#
+# MoonPilot "moonpilot-juier" airframe.
+#
+# Hardware: custom STM32H743VIH6 flight controller, built as the
+# "moonpilot_tof" firmware target (boards/moonpilot/tof), with a downward
+# facing Nooploop TOFSense-M/MS rangefinder on UART2 RX (/dev/ttyS1, U11.6).
+#
+
+. ${R}etc/init.d/rc.mc_defaults
+
+# ---------------------------------------------------------------------------
+# Quad X, PX4 motor numbering: M1..M4 on PWM outputs 1..4 (U17.1..U17.4)
+# ---------------------------------------------------------------------------
+param set-default CA_ROTOR_COUNT 4
+
+param set-default CA_ROTOR0_PX 1
+param set-default CA_ROTOR0_PY 1
+
+param set-default CA_ROTOR1_PX -1
+param set-default CA_ROTOR1_PY -1
+
+param set-default CA_ROTOR2_PX 1
+param set-default CA_ROTOR2_PY -1
+param set-default CA_ROTOR2_KM -0.05
+
+param set-default CA_ROTOR3_PX -1
+param set-default CA_ROTOR3_PY 1
+param set-default CA_ROTOR3_KM -0.05
+
+# PWM outputs 1..4 -> Motor 1..4 (101..104), outputs 5..8 stay disabled
+# (PWM_MAIN_FUNCx defaults to 0 = Disabled, so this mapping is required)
+param set-default PWM_MAIN_FUNC1 101
+param set-default PWM_MAIN_FUNC2 102
+param set-default PWM_MAIN_FUNC3 103
+param set-default PWM_MAIN_FUNC4 104
+
+# ---------------------------------------------------------------------------
+# Nooploop TOFSense-M/MS rangefinder (driver started in etc/init.d/rc.board_sensors)
+#
+# EKF2_RNG_CTRL:
+#   0 = disabled, 1 = continuous fusion of the range finder
+# ---------------------------------------------------------------------------
+param set-default EKF2_RNG_CTRL 1
+
+# For indoor altitude hold with the range finder as the primary height source
+# (instead of baro / GPS), also set:
+#   param set-default EKF2_HGT_REF 2      # 2 = range finder

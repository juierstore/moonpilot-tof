diff --git a/boards/corvon/743v2/init/rc.board_defaults b/boards/corvon/743v2/init/rc.board_defaults
index 3be80710a3..f9f2384641 100755
--- a/boards/corvon/743v2/init/rc.board_defaults
+++ b/boards/corvon/743v2/init/rc.board_defaults
@@ -60,3 +60,23 @@ param set-default MAV_2_CONFIG    104
 param set-default MAV_2_MODE      0
 param set-default MAV_2_RATE      1200
 param set-default MAV_2_FLOW_CTRL 0
+
+# >>> tof_sense_ms >>>
+# Nooploop TOFSense on TELEM 3 (/dev/ttyS4), 921600 8N1, downward facing.
+# The driver itself is started by the auto generated rc.serial script.
+param set-default SENS_TOFMS_CFG   103
+param set-default SENS_TOFMS_ROT   25
+param set-default SENS_TOFMS_AGG   0
+param set-default SENS_TOFMS_MIN   0.15
+param set-default SENS_TOFMS_MAX   4.0
+param set-default SER_TEL3_BAUD    921600
+
+# Raspberry Pi CM5 companion link on TELEM 2 (/dev/ttyS3), uXRCE-DDS at 921600.
+# MAV_1 is released so that MAVLink does not claim the same port as uXRCE-DDS.
+# PX4 v1.18 has no SER_TEL2_FLOW parameter: the DDS client flow control is
+# UXRCE_DDS_FLCTRL (0 = off), MAVLink uses MAV_x_FLOW_CTRL.
+param set-default MAV_1_CONFIG      0
+param set-default UXRCE_DDS_CFG     102
+param set-default UXRCE_DDS_FLCTRL  0
+param set-default SER_TEL2_BAUD     921600
+# <<< tof_sense_ms <<<
